APP_NAME=AlvoFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://alvoflow.test

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Laragon: crie a base de dados "alvoflow" no HeidiSQL/phpMyAdmin antes de migrar.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alvoflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
